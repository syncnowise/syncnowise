# SMTP credentials used by the "Start a Project" contact form to send email.
# Copy this file to .env and fill in real values — .env is gitignored and must
# never be committed.
#
# SMTP_USER: the Gmail address that sends the email (e.g. syncnowise@gmail.com)
# SMTP_PASS: a Google Account "App Password" for that address — NOT your normal
#            Gmail password. Generate one at https://myaccount.google.com/apppasswords
#            (requires 2-Step Verification to be enabled on the account).
# CONTACT_TO_EMAIL: the inbox that receives submissions (usually the same as SMTP_USER).
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=syncnowise@gmail.com
